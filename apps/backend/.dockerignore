# ===========================================
# FastAPI Production .dockerignore
# Based on Docker + Azure best practices
# ===========================================

# Python bytecode & cache
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments (CRITICAL - 400MB-2GB)
env/
venv/
.venv/
.venv
ENV/
.python-version

# Version control
.git/
.github/
.gitignore

# Environment files (secrets - never include)
.env
.env.*
!.env.example

# Editor & IDE
.idea/
.vscode/
*.swp
*.swo

# Build outputs
dist/
build/
*.egg-info/
coverage/
htmlcov/

# Test files (not needed in production)
tests/
data/
*.test.py
*_test.py
test_*.py
conftest.py
pytest.ini
requirements-test.txt
.coverage

# Evaluation tools (not needed in production)
.deepeval/

# Documentation (not needed in production)
*.md
docs/
README*
CHANGELOG*
LICENSE*

# Debug & logs
*.log
pip-log.txt

# OS files
.DS_Store
Thumbs.db

# Docker files (prevent recursive include)
Dockerfile*
docker-compose*
.dockerignore

# Node artifacts (if accidentally present)
node_modules/
.next/

# Misc
tmp/
*.tmp
scripts/

# Keep prompt file (required for RAG)
!policytech_prompt.txt
