# ===========================================
# Next.js Production .dockerignore
# Based on Docker + Vercel best practices
# ===========================================

# Dependencies (CRITICAL - 478MB+, installed fresh in container)
node_modules/

# Build outputs (rebuilt in container)
.next/
out/
dist/
build/

# Version control
.git/
.github/
.gitignore

# Environment files (secrets - never include)
.env
.env.*
!.env.example

# Editor & IDE
.idea/
.vscode/
*.swp
*.swo

# Test files (not needed in production)
*.test.ts
*.test.tsx
*.spec.ts
*.spec.tsx
__tests__/
coverage/
.jest/
jest.config.*
cypress/
playwright/

# Documentation (not needed in production)
*.md
docs/
README*
CHANGELOG*
LICENSE*

# Debug & logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# OS files
.DS_Store
Thumbs.db

# Misc build tools
.turbo/
.vercel/
.eslintcache
.stylelintcache
*.tsbuildinfo
tmp/

# Docker files (prevent recursive include)
Dockerfile*
docker-compose*
.dockerignore
